# ===================================
# HTTP Server
# ===================================
HTTP_DOMAIN=localhost
HTTP_PORT=8080

# ===================================
# Postgres
# ===================================
POSTGRES_VERSION=15
POSTGRES_CONTAINER=cinema_postgres_db
POSTGRES_HOST_PORT=15015


PDB_HOST=localhost
PDB_PORT=15015
PDB_USER=admin
PDB_PASSWORD=admin
PDB_DB_NAME=cinema_ticket
PDB_SSL_MODE=disable

# ===================================
# Redis
# ===================================
REDIS_VERSION=7
REDIS_CONTAINER=cinema_redis_cache
REDIS_HOST_PORT=15016


RDB_HOST=localhost
RDB_PORT=15016
RDB_PASSWORD=123123
RDB_DB_NUMBER=0

# ===================================
# PgAdmin
# ===================================
PGADMIN_VERSION=latest
PGADMIN_CONTAINER=cinema_pgadmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=15017

# ===================================
# JWT Config
# ===================================
JWT_ACCESS_PRIVATE=BimehFaghat
JWT_ACCESS_EXPIRE_MINUTES=15

JWT_REFRESH_PRIVATE=DoaeMadar
JWT_REFRESH_EXPIRE_DAYS=10